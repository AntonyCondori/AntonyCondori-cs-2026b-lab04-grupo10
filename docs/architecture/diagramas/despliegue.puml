@startuml
left to right direction
skinparam componentStyle rectangle
title EcoRecicla AQP — Vista de despliegue
actor "Vecinos, recicladores\ny municipalidad" as usuarios
node "PWA / navegador\nCola local y reintentos con UUID" as pwa
node "Un servidor en la nube\nSin alta disponibilidad" {
  node "Nginx\nHTTPS / proxy inverso" as proxy
  component "API Node.js / monolito modular\nIdentidad, Solicitudes, Rutas,\nPuntos y Reportes" as app
  database "PostgreSQL\nUn esquema por módulo" as db
  component "Monitoreo / Grafana\nFuente de métricas por definir" as mon
}
cloud "Mapas / geocodificación\nProveedor pendiente (S-03)" as mapas
node "Respaldo externo\nAcceso restringido" as respaldo
usuarios --> pwa : interacción
pwa --> proxy : HTTPS / API REST
proxy --> app : HTTP local
app --> db : SQL / transacciones
app ..> mon : salud y métricas
app ..> mapas : HTTPS
 db ..> respaldo : copia diaria cifrada
@enduml
